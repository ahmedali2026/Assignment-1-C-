using System;

namespace EmployeeManagement
{
    // 1. Security Privileges Enum
    [Flags]
    public enum SecurityLevel
    {
        Guest = 1,
        Developer = 2,
        Secretary = 4,
        DBA = 8,
        SecurityOfficer = 16 // صلاحيات كاملة
    }

    // 2. Hiring Date Class
    public class HiringDate
    {
        private int day;
        private int month;
        private int year;

        public int Day
        {
            get => day;
            set => day = (value >= 1 && value <= 31) ? value : 1;
        }

        public int Month
        {
            get => month;
            set => month = (value >= 1 && value <= 12) ? value : 1;
        }

        public int Year
        {
            get => year;
            set => year = (value >= 1900 && value <= 2100) ? value : 2026;
        }

        // Constructors
        public HiringDate()
        {
            Day = 1;
            Month = 1;
            Year = 2026;
        }

        public HiringDate(int day, int month, int year)
        {
            Day = day;
            Month = month;
            Year = year;
        }

        public override string ToString()
        {
            return string.Format("{0:D2}/{1:D2}/{2}", Day, Month, Year);
        }
    }

    // 3. Employee Class
    public class Employee
    {
        private int id;
        private string name;
        private SecurityLevel securityLevel;
        private decimal salary;
        private HiringDate hireDate;
        private char gender;

        public int Id
        {
            get => id;
            set => id = (value > 0) ? value : 1;
        }

        public string Name
        {
            get => name;
            set => name = string.IsNullOrWhiteSpace(value) ? "Unknown" : value;
        }

        public SecurityLevel SecurityLevel
        {
            get => securityLevel;
            set => securityLevel = value;
        }

        public decimal Salary
        {
            get => salary;
            set => salary = (value >= 0) ? value : 0;
        }

        public HiringDate HireDate
            {
            get => hireDate;
            set => hireDate = value ?? new HiringDate();
        }

        public char Gender
        {
            get => gender;
            set
            {
                char upper = char.ToUpper(value);
                gender = (upper == 'M' || upper == 'F') ? upper : 'M'; // افتراضي M في حال الخطأ
            }
        }

        // Constructors
        public Employee()
        {
            Id = 1;
            Name = "Not Assigned";
            SecurityLevel = SecurityLevel.Guest;
            Salary = 0.0m;
            HireDate = new HiringDate();
            Gender = 'M';
        }

        public Employee(int id, string name, SecurityLevel securityLevel, decimal salary, HiringDate hireDate, char gender)
        {
            Id = id;
            Name = name;
            SecurityLevel = securityLevel;
            Salary = salary;
            HireDate = hireDate;
            Gender = gender;
        }

        // ToString Override with Currency Format
        public override string ToString()
        {
            string formattedSalary = string.Format("{0:C}", Salary);
            return string.Format("ID: {0} | Name: {1} | Gender: {2} | Security Level: {3} | Salary: {4} | Hire Date: {5}",
                Id, Name, Gender, SecurityLevel, formattedSalary, HireDate);
        }
    }

    // 4. Program Execution
    class Program
    {
        static void Main(string[] args)
        {
            // إنشاء مصفوفة موظفين بحجم 3 كما مطلوب
            Employee[] EmpArr = new Employee[3];

            // تعبئة البيانات (DBA, Guest, Security Officer)
            EmpArr[0] = new Employee(1, "Ahmed Ali", SecurityLevel.DBA, 15000.00m, new HiringDate(10, 5, 2020), 'M');
            EmpArr[1] = new Employee(2, "Sara Mohamed", SecurityLevel.Guest, 4500.50m, new HiringDate(1, 12, 2023), 'F');
            EmpArr[2] = new Employee(3, "Khaled Omar", SecurityLevel.SecurityOfficer, 25000.00m, new HiringDate(15, 8, 2018), 'M');

            // طباعة بيانات الموظفين
            Console.WriteLine("=================== Employee Records ===================");
            foreach (var emp in EmpArr)
            {
                Console.WriteLine(emp.ToString());
            }
            Console.WriteLine("========================================================");
        }
    }
}
