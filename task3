        public static void PointDistanceDemo()
        {
            Console.WriteLine("Enter Point 1 (X Y):");
            string[] p1Input = Console.ReadLine().Split(' ');
            Point p1 = new Point(double.Parse(p1Input[0]), double.Parse(p1Input[1]));

            Console.WriteLine("Enter Point 2 (X Y):");
            string[] p2Input = Console.ReadLine().Split(' ');
            Point p2 = new Point(double.Parse(p2Input[0]), double.Parse(p2Input[1]));

            double distance = Math.Sqrt(Math.Pow(p2.X - p1.X, 2) + Math.Pow(p2.Y - p1.Y, 2));
            Console.WriteLine($"Distance between points: {distance:F2}");
        }

        // 7. Oldest Person from 3 Inputs
        static void FindOldestPerson()
        {
            Person[] persons = new Person[3];
            for (int i = 0; i < 3; i++)
            {
                Console.Write($"Enter name for person {i + 1}: ");
                string name = Console.ReadLine();
                Console.Write($"Enter age for person {i + 1}: ");
                int age = int.Parse(Console.ReadLine());
                persons[i] = new Person(name, age);
            }

            Person oldest = persons[0];
            foreach (var p in persons)
            {
                if (p.Age > oldest.Age)
                {
                    oldest = p;
                }
            }

            Console.WriteLine($"The oldest person is {oldest.Name} with age {oldest.Age}.");
        }

