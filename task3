        /*
         * شرح الفرق بين تمرير Value Type (مثل int) بالـ Value وبالـ Reference:
         * 1. Pass by Value (التمرير بالقيمة - الافتراضي):
         *    يتم إرسال "نسخة" من القيمة للدالة. أي تعديل يتم داخل الدالة لا يؤثر على المتغير الأصلي في الخارج.
         * 2. Pass by Reference (التمرير بالمرجع باستخدام كلمة ref):
         *    يتم إرسال عنوان الذاكرة (Memory Address) الخاص بالميتغير الأصلي. أي تعديل داخل الدالة سينعكس مباشرة على المتغير الأصلي.
         */

        public static void ValueTypeDemo()
        {
            int originalVal = 10;
            
            // By Value:
            ModifyByValue(originalVal);
            Console.WriteLine(originalVal); // النتيجة ستظل 10

            // By Reference:
            ModifyByReference(ref originalVal);
            Console.WriteLine(originalVal); // النتيجة ستصبح 20
        }

        static void ModifyByValue(int x)
        {
            x = 20;
        }

        static void ModifyByReference(ref int x)
        {
            x = 20;
        }
