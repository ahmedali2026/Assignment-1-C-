        static void PermissionsDemo()
        {
            Permissions userPermissions = Permissions.Read;

            // Add Permission (Write)
            userPermissions |= Permissions.Write;

            // Remove Permission (Read)
            userPermissions &= ~Permissions.Read;

            // Check if specific permission exists (e.g., Write)
