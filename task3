        /*
         * شرح الفرق بين تمرير Reference Type (مثل Class أو Array) بالـ Value وبالـ Reference:
         * 1. Pass by Value:
         *    يتم تمرير نسخة من "عنوان" الكائن. إذا قامت الدالة بتعديل محتويات الكائن (مثل تعديل قيمة داخله)، سيتأثر الكائن الأصلي.
         *    ولكن لو قامت الدالة بإنشاء كائن جديد (using new)، فإن المتغير الأصلي لن يتأثر.
         * 2. Pass by Reference (باستخدام ref):
         *    يتم تمرير المرجع نفسه، مما يسمح للدالة بتغيير الكائن بالكامل وجعل المتغير الأصلي يشير إلى كائن جديد.
         */

        public class MyClass { public int Value = 5; }

        public static void RefTypeDemo()
        {
            MyClass obj = new MyClass();
            obj.Value = 5;

            // By Value (تعديل المحتوى يؤثر، لكن تغيير المرجع لا يؤثر)
            ChangeRefTypeContent(obj);
            Console.WriteLine(obj.Value); // 10

            // By Reference (يسمح بتغيير الكائن بالكامل)
            ChangeRefTypeReference(ref obj);
        }

        static void ChangeRefTypeContent(MyClass c)
        {
            c.Value = 10; // يؤثر على الأصل
        }

        static void ChangeRefTypeReference(ref MyClass c)
        {
            c = new MyClass();
            c.Value = 100; // يغير المرجع بالكامل
        }
